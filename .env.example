# Kumgang Project Monitoring System - Environment Configuration Template

# Optional: Google Drive Central Folder URL
VITE_GOOGLE_DRIVE_URL=

# Optional: Remote ERP Integration Endpoint URL
VITE_ERP_API_URL=

# --- Developer Portal Access (Part 14) ---
# SHA-256 hash of the authorized Developer access password.
# Generate with the app's hashing: SHA-256 of (password + "KKI_SECURE_SALT_2026_v1!").
# The plaintext password is NEVER stored in source. If this is not set, Developer
# login is rejected (no unauthenticated bypass). Example generation (Node):
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_DEV_PASSWORD'+'KKI_SECURE_SALT_2026_v1!').digest('hex'))"
#
# Local / demo testing: the current authorized password is the numeric PIN "77".
# Do NOT commit the plaintext PIN anywhere. To rotate, regenerate the hash above and
# update this value. Vercel Production must set the same variable in its project
# Environment Variables panel (not in this gitignored file).
VITE_DEVELOPER_PASSWORD_HASH=

# --- Demo / Evaluation Shortcut Modes (Admin & PM) ---
# The landing-page "Admin Mode" and "PM Mode" buttons, and the Client Access page
# role switcher, are SIMULATED evaluation shortcuts: they skip credential verification
# and switch the session role directly. By default they are DISABLED on public
# Production and ENABLED only when VITE_DEMO_MODE is set to "true" (for local /
# authorized demos). The Developer password above is a real (hashed) credential and
# is always checked when VITE_DEVELOPER_PASSWORD_HASH is configured, regardless of
# VITE_DEMO_MODE.
#
# Production: leave unset or set to "false".
# Authorized demo / evaluation: set to "true".
VITE_DEMO_MODE=

# --- Currency Display (Part 16) ---
# Optional: configured exchange rates (USD base) used when the live market-rate
# provider is unreachable. Provide valid rates with an effective date, e.g.:
#   VITE_EXCHANGE_RATES_JSON={"INR":83.25,"KRW":1340.5,"effectiveDate":"2026-01-01"}
# If unset (and the live provider is unreachable), non-USD selections display the
# original USD amount with an "rate unavailable" indicator. Original stored values
# are never modified.
VITE_EXCHANGE_RATES_JSON=

# Server-side email configuration
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=तुझा_email@example.com
