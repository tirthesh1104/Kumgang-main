# Kumgang Project Monitoring System - Environment Configuration Template

# Optional: Google Drive Central Folder URL (defaults to safe corporate modal if unset)
VITE_GOOGLE_DRIVE_URL=

# Optional: Remote ERP Integration Endpoint URL (defaults to canonical offline MIS mode if unset)
VITE_ERP_API_URL=

# Real Email Delivery Configuration (Vercel Serverless / Server-side only)
# Resend Transactional Email API Key (never prefix with VITE_)
RESEND_API_KEY=
# Sender Email (e.g. Kumgang Approvals <onboarding@resend.dev> or approvals@kumgangkind.com)
EMAIL_FROM=
# Reply-to Email address
EMAIL_REPLY_TO=
